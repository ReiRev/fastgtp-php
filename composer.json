{
    "name": "reirev/fastgtp",
    "description": "PHP client for fastgtp, an HTTP API for Go engines and KataGo analysis.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["go", "baduk", "weiqi", "gtp", "katago", "fastgtp"],
    "homepage": "https://github.com/ReiRev/fastgtp-php",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "laravel/pint": "^1.18",
        "opis/json-schema": "^2.4",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "FastGtp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FastGtp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-integration": "phpunit --testsuite integration",
        "format": "pint",
        "format-check": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
